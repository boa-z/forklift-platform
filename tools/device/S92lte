#!/bin/sh
#
# 4G 数据链路：等待 USB 枚举（PF7 上电由 DTS hog 完成），为 usb0 取 DHCP。
#
# ECM（usbnet=1）由 cdc_ether、RNDIS（usbnet=3）由 rndis_host 按接口类自动
# 绑定到 usb0，均不需要 AT 参与。模组 AT 口如需使用，由部署侧按需动态绑定
# option 驱动（forklift-platform 提供 atsend 诊断工具）。
#
# 固件镜像不携带 forklift-platform 的构建产物。

wait_usb0() {
	i=0
	while [ "$i" -lt "$1" ]; do
		[ -d /sys/class/net/usb0 ] && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

start() {
	printf "Starting lte: "
	if ! wait_usb0 60; then
		printf "Fail (no usb0)\n"
		return 1
	fi
	ifconfig usb0 up
	i=0
	while [ "$i" -lt 20 ]; do
		if ifconfig usb0 2>/dev/null | grep -q RUNNING; then
			break
		fi
		i=$((i + 1))
		sleep 1
	done
	if udhcpc -i usb0 -q -n -b; then
		printf "dhcp OK \n"
	else
		printf "dhcp Fail \n"
		return 1
	fi
}

stop() {
	printf "Stopping lte: "
	if [ -f /var/run/udhcpc.usb0.pid ]; then
		kill "$(cat /var/run/udhcpc.usb0.pid)" 2>/dev/null
	fi
	printf "OK \n"
}

case "$1" in
start)
	start
	;;
stop)
	stop
	;;
restart|reload)
	stop
	sleep 1
	start
	;;
*)
	echo "usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
