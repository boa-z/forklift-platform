#!/bin/sh
#
# 4G 数据链路：等待 USB 枚举（PF7 上电由 DTS hog 完成），必要时把模组切到
# ECM 模式，最后为 usb0 取 DHCP。模组 AT 口随模式/枚举顺序变化，脚本按
# 常见端口顺序探测响应 "OK" 的端口。

AT_PORTS="3 4 2 1 5"

find_at_port() {
	for p in $AT_PORTS; do
		[ -c "/dev/ttyUSB$p" ] || continue
		if atsend "/dev/ttyUSB$p" AT 2>/dev/null | grep -q OK; then
			echo "/dev/ttyUSB$p"
			return 0
		fi
	done
	return 1
}

wait_usb0() {
	i=0
	while [ "$i" -lt 30 ]; do
		[ -d /sys/class/net/usb0 ] && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

start() {
	printf "Starting lte: "
	if wait_usb0; then
		printf "usb0 ready; "
	else
		# 模组可能仍是 RNDIS（出厂默认 3）：切 ECM 并复位重枚举。
		AT=$(find_at_port)
		if [ -z "$AT" ]; then
			printf "Fail (no AT port)\n"
			return 1
		fi
		printf "switch ECM via %s; " "$AT"
		atsend "$AT" 'AT+QCFG="usbnet",1' >/dev/null 2>&1
		atsend "$AT" 'AT+CFUN=1,1' >/dev/null 2>&1
		if ! wait_usb0; then
			printf "Fail (no usb0)\n"
			return 1
		fi
	fi
	if udhcpc -i usb0 -q -n -b; then
		printf "dhcp OK \n"
	else
		printf "dhcp Fail \n"
		return 1
	fi
}

stop() {
	printf "Stopping lte: "
	if [ -f /var/run/udhcpc.usb0.pid ]; then
		kill "$(cat /var/run/udhcpc.usb0.pid)" 2>/dev/null
	fi
	printf "OK \n"
}

case "$1" in
start)
	start
	;;
stop)
	stop
	;;
restart|reload)
	stop
	sleep 1
	start
	;;
*)
	echo "usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
