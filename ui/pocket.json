{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.forklift",
  "name": "forklift-ui",
  "title": "Forklift Instrument",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "ui/main.tsx",
    "output": "forklift-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [800, 480],
        "presentation": "native"
      }
    }
  }
}
